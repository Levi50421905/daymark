{
  "name": "daymark",
  "private": true,
  "version": "1.0.0",
  "description": "Daymark — a local-first personal life planner for money, shopping, food, plans, and reflection.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
